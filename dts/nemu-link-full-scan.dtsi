/* SPDX-License-Identifier: MIT */
#define NEMU_LINK_SCAN_CHANNEL(n, setting_value, label_value) \
		channel_##n: channel_##n { \
			compatible = "sekigon,dynamic-setting"; \
			setting-name = setting_value; \
			label = label_value; \
			value-type = "u32"; \
			default-int = <0>; \
			read-only; \
			volatile; \
		};

/ {
	nemu_link_full_scan: nemu_link_full_scan {
		compatible = "sekigon,dynamic-settings-group";
		module-name = "nemu-link-scan";
		group-name = "full-band";
		instance-name = "dongle";
		label = "Nemu-link full-band scan";
		scope = "local";
		format-version = <1>;
		target-role = "nemu-link";
		actual-device = <&kscan0>;
		runtime-read-provider = "nemu_link_scan_read";

		scan: scan {
			compatible = "sekigon,dynamic-setting";
			setting-name = "scan";
			label = "スキャン開始";
			value-type = "bool";
			default-bool = <0>;
			widget = "button";
			on-change = "nemu_link_scan_command_changed";
		};

		/* BLE advertising channels (0..39) plus 40 data channels (40..79). */
		NEMU_LINK_SCAN_CHANNEL(0, "channel-0", "ch 0")
		NEMU_LINK_SCAN_CHANNEL(1, "channel-1", "ch 1")
		NEMU_LINK_SCAN_CHANNEL(2, "channel-2", "ch 2")
		NEMU_LINK_SCAN_CHANNEL(3, "channel-3", "ch 3")
		NEMU_LINK_SCAN_CHANNEL(4, "channel-4", "ch 4")
		NEMU_LINK_SCAN_CHANNEL(5, "channel-5", "ch 5")
		NEMU_LINK_SCAN_CHANNEL(6, "channel-6", "ch 6")
		NEMU_LINK_SCAN_CHANNEL(7, "channel-7", "ch 7")
		NEMU_LINK_SCAN_CHANNEL(8, "channel-8", "ch 8")
