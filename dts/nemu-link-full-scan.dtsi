		NEMU_LINK_SCAN_CHANNEL(10, "channel-10", "ch 10")
		NEMU_LINK_SCAN_CHANNEL(11, "channel-11", "ch 11")
		NEMU_LINK_SCAN_CHANNEL(12, "channel-12", "ch 12")
		NEMU_LINK_SCAN_CHANNEL(13, "channel-13", "ch 13")
		NEMU_LINK_SCAN_CHANNEL(14, "channel-14", "ch 14")
