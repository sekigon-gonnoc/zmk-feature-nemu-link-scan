		NEMU_LINK_SCAN_CHANNEL(25, "channel-25", "ch 25")
		NEMU_LINK_SCAN_CHANNEL(26, "channel-26", "ch 26")
		NEMU_LINK_SCAN_CHANNEL(27, "channel-27", "ch 27")
